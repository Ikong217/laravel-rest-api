{
  "name": "ikongdev/laravel-rest-api",
  "description": "A lightweight Laravel package that simplifies REST API requests and effortlessly handles JSON, XML, and plain string responses.",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "IkongDev\\RestApi\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Jericho Umayam",
      "email": "jerichoumayam473@gmail.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^11.0|^12.0",
    "laravel/sanctum": "^4.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0",
    "illuminate/validation": "^11.0|^12.0"
  },
  "extra": {
    "laravel": {
      "providers": [
        "IkongDev\\RestApi\\ApiResponseServiceProvider"
      ]
    }
  }
}
